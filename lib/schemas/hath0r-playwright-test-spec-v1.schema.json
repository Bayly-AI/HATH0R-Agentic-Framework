{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-playwright-test-spec-v1.schema.json",
  "title": "hath0r.playwright.testspec/1",
  "description": "JSON Schema specification for Hath0r Master Playwright Test Case Catalog and UI test definitions.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "last_synced_at",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["hath0r.playwright.testspec/1"]
    },
    "project": {
      "type": "string",
      "description": "Target project or repository name."
    },
    "last_synced_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of last catalog sync."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" },
        "default_browser": { "type": "string", "enum": ["chromium", "firefox", "webkit"] },
        "default_timeout_ms": { "type": "integer" },
        "viewport": {
          "type": "object",
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          },
          "required": ["width", "height"]
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite_id", "title", "target_component", "test_cases"],
        "properties": {
          "suite_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "target_component": { "type": "string" },
          "target_path": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "test_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["test_id", "title", "status", "steps"],
              "properties": {
                "test_id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["automated", "pending_generation", "manual", "skipped", "deprecated"]
                },
                "browser": {
                  "type": "string",
                  "enum": ["chromium", "firefox", "webkit"]
                },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["step_number", "action"],
                    "properties": {
                      "step_number": { "type": "integer" },
                      "action": {
                        "type": "string",
                        "enum": [
                          "goto",
                          "click",
                          "fill",
                          "type",
                          "press",
                          "hover",
                          "waitForSelector",
                          "waitForTimeout",
                          "expectVisible",
                          "expectText",
                          "expectValue",
                          "expectVisualMatch",
                          "screenshot"
                        ]
                      },
                      "selector": { "type": "string" },
                      "value": { "type": "string" },
                      "timeout_ms": { "type": "integer" },
                      "expected": { "type": "string" },
                      "snapshot_name": { "type": "string" }
                    }
                  }
                },
                "expected_outcome": { "type": "string" },
                "created_at": { "type": "string" },
                "updated_at": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bayly-AI/HATH0R-Agentic-Framework/development/contracts/hath0r-pmat-churn-report-v1.schema.json",
  "title": "Hath0rPmatChurnReport",
  "description": "Canonical schema contract for PMAT code churn, file volatility, and architectural hotspot analysis.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "timestamp",
    "summary",
    "hotspots"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["hath0r.pmat.churn/1", "1.0.0"],
      "description": "Schema version identifier for PMAT churn report payloads."
    },
    "repository": {
      "type": "string",
      "description": "Repository identifier or absolute workspace path."
    },
    "commit_hash": {
      "type": "string",
      "description": "Base or current HEAD commit SHA."
    },
    "analysis_window_days": {
      "type": "integer",
      "minimum": 1,
      "default": 30,
      "description": "Time window in days for commit churn aggregation."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of analysis execution."
    },
    "summary": {
      "type": "object",
      "required": [
        "total_files_analyzed",
        "total_commits_evaluated",
        "total_churn_lines",
        "mean_volatility_score",
        "hotspot_count"
      ],
      "properties": {
        "total_files_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "total_commits_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "total_churn_lines": {
          "type": "integer",
          "minimum": 0
        },
        "mean_volatility_score": {
          "type": "number",
          "minimum": 0.0
        },
        "hotspot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChurnHotspot"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ChurnHotspot": {
      "type": "object",
      "required": [
        "file_path",
        "churn_count",
        "lines_added",
        "lines_deleted",
        "complexity_score",
        "volatility_score",
        "risk_tier"
      ],
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Relative file path from repository root."
        },
        "churn_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of commits modifying this file within the window."
        },
        "lines_added": {
          "type": "integer",
          "minimum": 0
        },
        "lines_deleted": {
          "type": "integer",
          "minimum": 0
        },
        "complexity_score": {
          "type": "number",
          "minimum": 0.0,
          "description": "Calculated AST cyclomatic/cognitive complexity score."
        },
        "volatility_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Normalized volatility score combining churn frequency, churn volume, and complexity."
        },
        "risk_tier": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
          "description": "Architectural risk tier classification."
        },
        "co_changing_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of companion files frequently modified in the same commits."
        }
      }
    }
  }
}

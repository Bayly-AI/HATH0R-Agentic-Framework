{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hath0r.bayly.ai/contracts/hath0r-agent-metrics-report-v1.schema.json",
  "title": "Hath0r Agent Metrics Comprehensive Report Schema",
  "description": "Defines comprehensive reporting schema aggregating Observability, Histogram distributions, PMAT multi-dimensional metrics, and TUI rendering metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "bot_id",
    "intent",
    "summary",
    "observability",
    "histogram",
    "pmat",
    "tui_metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hath0r.agent.metrics/1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "bot_id": {
      "type": "string",
      "const": "agent-metrics-bot"
    },
    "intent": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_requests",
        "total_tokens",
        "total_cost_usd",
        "mean_latency_ms",
        "p90_latency_ms",
        "mean_provability_score",
        "hotspot_count",
        "calibration_fresh"
      ],
      "properties": {
        "total_requests": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0.0 },
        "mean_latency_ms": { "type": "number", "minimum": 0.0 },
        "p90_latency_ms": { "type": "number", "minimum": 0.0 },
        "mean_provability_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "hotspot_count": { "type": "integer", "minimum": 0 },
        "calibration_fresh": { "type": "boolean" }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "total_requests",
        "total_tokens",
        "total_cost_usd",
        "latency_quantiles",
        "calibration_state"
      ],
      "properties": {
        "total_requests": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0.0 },
        "latency_quantiles": {
          "type": "object",
          "required": ["p50", "p90", "p95", "p99", "mean", "std_dev"],
          "properties": {
            "p50": { "type": "number", "minimum": 0.0 },
            "p90": { "type": "number", "minimum": 0.0 },
            "p95": { "type": "number", "minimum": 0.0 },
            "p99": { "type": "number", "minimum": 0.0 },
            "mean": { "type": "number", "minimum": 0.0 },
            "std_dev": { "type": "number", "minimum": 0.0 }
          }
        },
        "calibration_state": {
          "type": "object",
          "required": ["fresh", "total_runs", "drift_metrics"],
          "properties": {
            "fresh": { "type": "boolean" },
            "last_run_timestamp": { "type": ["string", "null"] },
            "total_runs": { "type": "integer", "minimum": 0 },
            "drift_metrics": { "type": "object" }
          }
        }
      }
    },
    "histogram": {
      "type": "object",
      "required": ["metric", "total_records", "stats", "bins"],
      "properties": {
        "metric": { "type": "string" },
        "total_records": { "type": "integer", "minimum": 0 },
        "stats": { "type": "object" },
        "bins": { "type": "array" },
        "user_distribution": { "type": "object" },
        "model_distribution": { "type": "object" }
      }
    },
    "pmat": {
      "type": "object",
      "required": [
        "repository",
        "commit_hash",
        "summary",
        "churn",
        "provability",
        "complexity",
        "hotspots"
      ],
      "properties": {
        "repository": { "type": "string" },
        "commit_hash": { "type": "string" },
        "summary": { "type": "object" },
        "churn": { "type": "object" },
        "provability": { "type": "object" },
        "complexity": { "type": "object" },
        "hotspots": { "type": "array" },
        "remediation_items": { "type": "array" }
      }
    },
    "tui_metadata": {
      "type": "object",
      "required": ["render_mode", "tui_supported", "fallback_applied"],
      "properties": {
        "render_mode": { "type": "string", "enum": ["tui", "markdown", "auto"] },
        "tui_supported": { "type": "boolean" },
        "fallback_applied": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}

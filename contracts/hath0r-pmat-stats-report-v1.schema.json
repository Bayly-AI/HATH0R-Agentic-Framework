{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hath0r.bayly.ai/contracts/hath0r-pmat-stats-report-v1.schema.json",
  "title": "Hath0r PMAT Multi-Dimensional Stats & Provability Report Schema",
  "description": "Defines multi-dimensional reporting schema for Code Churn, Formal Provability, AST Complexity, and Composite Hotspot Risk Index.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "commit_hash",
    "timestamp",
    "summary",
    "churn",
    "provability",
    "complexity",
    "hotspots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hath0r.pmat.stats/1"
    },
    "repository": {
      "type": "string"
    },
    "commit_hash": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_files_analyzed",
        "total_commits_evaluated",
        "mean_volatility_score",
        "mean_provability_score",
        "mean_complexity_score",
        "hotspot_count"
      ],
      "properties": {
        "total_files_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "total_commits_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "mean_volatility_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "mean_provability_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "mean_complexity_score": {
          "type": "number",
          "minimum": 0.0
        },
        "hotspot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "churn": {
      "type": "object",
      "required": [
        "time_window_days",
        "total_lines_added",
        "total_lines_deleted",
        "temporal_decay_factor"
      ],
      "properties": {
        "time_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "total_lines_added": {
          "type": "integer",
          "minimum": 0
        },
        "total_lines_deleted": {
          "type": "integer",
          "minimum": 0
        },
        "temporal_decay_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "provability": {
      "type": "object",
      "required": [
        "formal_verification_coverage",
        "invariant_safety_score",
        "defect_probability_index"
      ],
      "properties": {
        "formal_verification_coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "invariant_safety_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "defect_probability_index": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "complexity": {
      "type": "object",
      "required": [
        "cyclomatic_complexity",
        "cognitive_complexity",
        "max_ast_depth",
        "halstead_volume"
      ],
      "properties": {
        "cyclomatic_complexity": {
          "type": "number",
          "minimum": 0.0
        },
        "cognitive_complexity": {
          "type": "number",
          "minimum": 0.0
        },
        "max_ast_depth": {
          "type": "integer",
          "minimum": 0
        },
        "halstead_volume": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_path",
          "churn_score",
          "provability_score",
          "complexity_score",
          "composite_hotspot_risk_index",
          "risk_tier"
        ],
        "properties": {
          "file_path": {
            "type": "string"
          },
          "churn_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "provability_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "complexity_score": {
            "type": "number",
            "minimum": 0.0
          },
          "composite_hotspot_risk_index": {
            "type": "number",
            "minimum": 0.0
          },
          "risk_tier": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          }
        }
      }
    },
    "remediation_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_path", "recommended_action", "priority"],
        "properties": {
          "file_path": { "type": "string" },
          "recommended_action": { "type": "string" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
        }
      }
    }
  },
  "additionalProperties": true
}

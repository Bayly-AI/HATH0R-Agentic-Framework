      "test_cases": [
        {
          "test_id": "TC-SLIDER-001",
          "title": "ParameterSlider dispatches state updates on drag/input",
          "description": "Verify sliding the temperature parameter emits bidirectional state updates",
          "status": "automated",
          "browser": "chromium",
          "tags": [
            "interactive",
            "sync"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "goto",
              "value": "http://localhost:3000/components/parameter-slider"
            },
            {
              "step_number": 2,
              "action": "waitForSelector",
              "selector": "[data-testid='param-slider-temperature']",
              "timeout_ms": 5000
            },
            {
              "step_number": 3,
              "action": "fill",
              "selector": "[data-testid='param-slider-temperature']",
              "value": "0.85"
            },
            {
              "step_number": 4,
              "action": "expectValue",
              "selector": "[data-testid='param-slider-temperature']",
              "expected": "0.85"
            },
            {
              "step_number": 5,
              "action": "expectText",
              "selector": "[data-testid='slider-value-display']",
              "expected": "0.85"
            }
          ],
          "expected_outcome": "Slider position and bound value display update instantly to 0.85",
          "created_at": "2026-10-01T14:30:00Z",
          "updated_at": "2026-10-01T14:30:00Z"
        }
      ]
    },
